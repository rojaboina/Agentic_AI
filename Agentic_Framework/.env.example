# Choose: openai, ollama, or groq
LLM_PROVIDER=groq

# Groq hosted/free-tier friendly settings
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama-3.1-8b-instant
GROQ_BASE_URL=https://api.groq.com/openai/v1

# Memory settings. Use local for demos; use mem0 when MEM0_API_KEY is available.
MEMORY_PROVIDER=local
MEM0_API_KEY=your_mem0_api_key_here
MEM0_USER_ID=healthcare-review-demo
LOCAL_MEMORY_PATH=data/case_memory.json

# Ollama local/free settings
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=llama3.1:8b

# OpenAI settings, only needed when LLM_PROVIDER=openai
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4o-mini
