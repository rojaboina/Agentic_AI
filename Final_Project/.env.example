# Patient PDF source folder
PATIENT_DATA_DIR=/Users/roja/Documents/Agentic_AI/Final_Project/sample_patient_data

# Hugging Face embedding model
EMBEDDING_MODEL_NAME=pritamdeka/S-PubMedBert-MS-MARCO
EMBEDDING_DIMENSION=768

# Pinecone
PINECONE_API_KEY=your_pinecone_api_key_here
PINECONE_INDEX_NAME=patient-health-rag
PINECONE_CLOUD=aws
PINECONE_REGION=us-east-1

# Chunking
CHUNK_MAX_CHARS=2400
CHUNK_OVERLAP_CHARS=250

# Nebius/OpenAI-compatible query planner
LLM_BASE_URL=https://api.studio.nebius.com/v1
NEBIUS_API_KEY=your_nebius_api_key_here
QUERY_PLANNER_MODEL=Qwen/Qwen3-32B
